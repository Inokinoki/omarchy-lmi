pkgname=lmi-dsp
pkgver=0.4.0
pkgrel=1
pkgdesc='LMI FastRPC daemon, sensor registry and DSP configuration'
arch=(aarch64)
url='https://github.com/linux-msm/hexagonrpc'  # registry and modem inputs are device-private (M1)
license=(GPL-2.0-or-later LicenseRef-proprietary)
depends=(glibc)
makedepends=(meson ninja gcc)
options=(!strip)
source=(https://github.com/linux-msm/hexagonrpc/archive/93f3467dcfe1601bb70547611866a069ae914de5.tar.gz
        lmi-sensor-fixes.patch lmi-sensors-1.0.tar.gz
        lmi-fastrpc.conf 10-lmi-fastrpc.rules
        0001-tests-pass-lmi-registry-path.patch)
sha512sums=(
  0ebbd854c34c7e8a57b40432f6293b52a1dcd459096644b7d8d2fc132a23818d121e4d39891e32c392819dbe9dd0696f291769a4c83d04c2f732edeed1fad896
  1d2200dd6c7ccfa3310143c6be5dfc979d7c9ad97e862b581f47173b15bb66e0909151a52ecda9ff7ae26f37df25dbc8fa9a375ade3d3890feb52562c8ae8145
  SKIP  # lmi-sensors registry tarball: pending M1 extraction from the device
  b6a400edaebb128ef1d4654f6c3afab5b17fe59a3c0a1f20456daa00bf64fc20cf612a3f2d72eea5cc4fa2130e3bced378897cf83ac144d73d3f601c3333dc13
  a7dd6a1e80d9f327691f577a6e70c8172701dff69b6af46aee54aaa809ee8ec7d95cd3294031c313c7640519c112bdd2bcabe968e6a994edd4e12787d41cc6dc
  e57fd3eb9e140a281d94248e09b85b327daa65b7bf8175099be1ce265af2b5aeee5dfb618a69e6eb510519f204ae010b124c594c9d1cfd03cb6801f2f22d4a1e
))

prepare() {
  cd hexagonrpc-93f3467dcfe1601bb70547611866a069ae914de5
  patch -Np1 --fuzz=0 < "$srcdir/lmi-sensor-fixes.patch"
  patch -Np1 --fuzz=0 < "$srcdir/0001-tests-pass-lmi-registry-path.patch"
}

build() {
  meson setup hexagonrpc-93f3467dcfe1601bb70547611866a069ae914de5 build \
    --prefix=/usr --libdir=lib --libexecdir=lib --buildtype=release
  meson compile -C build -j 4
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build --no-rebuild
  install -Dm644 lmi-fastrpc.conf "$pkgdir/usr/lib/sysusers.d/lmi-fastrpc.conf"
  install -Dm644 10-lmi-fastrpc.rules "$pkgdir/usr/lib/udev/rules.d/10-lmi-fastrpc.rules"
  install -d "$pkgdir/usr/share/qcom"
  cp -a sm8250 "$pkgdir/usr/share/qcom/"
  # Keep mutable sensor state away from the firmware and Android persist.
  install -d "$pkgdir/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d"
  cat > "$pkgdir/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/10-lmi.conf" <<'EOF'
[Service]
StateDirectory=lmi-dsp
ExecStartPre=/usr/bin/cp -rn /usr/share/qcom/sm8250/Xiaomi/lmi/. /var/lib/lmi-dsp/
ExecStart=
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-sdsp -d sdsp -s -R /var/lib/lmi-dsp
EOF
  install -Dm644 hexagonrpc-93f3467dcfe1601bb70547611866a069ae914de5/COPYING \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
