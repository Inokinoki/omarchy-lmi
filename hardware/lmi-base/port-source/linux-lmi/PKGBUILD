pkgname=linux-lmi
pkgver=6.19.0
pkgrel=1
pkgdesc='Close-to-mainline lmi kernel with the POCO F2 Pro board support'
arch=(aarch64)
url='https://github.com/yuweiyuan8/linux'
license=(GPL-2.0-only)
depends=(kmod)
conflicts=(linux-aarch64)
options=(!strip)
# The assets are produced by build-kernel.sh from the pinned upstream source.
# CI also packages them (the ci.yml kernel job). This package never flashes
# phone partitions. The sha512 pins the archive from CI run 41451976137; the
# kernel build and the tar are not byte-reproducible, so a rebuilt archive
# needs a new pin.
source=("lmi-kernel-assets-$pkgver-$pkgrel.tar.xz")
sha512sums=('a94d596cdf13e28fb13a99bb9c07a500328d508c7c86e994c13c764d6f720541ffe62496fd44c438d61b36000fd59e9f535d48473ca9e4301d9948eafb5ef5b9')
prepare() {
  # makepkg extracts into $srcdir keeping the archive's top-level directory;
  # hoist assets/ so package()'s relative paths resolve.
  mv "$srcdir/lmi-kernel-assets-$pkgver-$pkgrel/assets" .
}
package() {
  install -d "$pkgdir/boot" "$pkgdir/usr/lib/modules" "$pkgdir/usr/share/licenses/$pkgname"
  cp -a assets/boot/lmi "$pkgdir/boot/"
  for dir in assets/lib/modules/*; do
    cp -a "$dir" "$pkgdir/usr/lib/modules/"
  done
  # depmod generates these on the target; they are not immutable package files.
  find "$pkgdir/usr/lib/modules" -maxdepth 2 -type f \
    \( -name 'modules.alias*' -o -name 'modules.dep*' -o -name 'modules.symbols*' \
       -o -name 'modules.softdep' -o -name 'modules.devname' -o -name 'modules.builtin*' \) -delete
  install -m644 assets/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
