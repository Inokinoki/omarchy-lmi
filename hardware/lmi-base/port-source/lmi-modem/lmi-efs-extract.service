[Unit]
Description=Extract this device's modem NV (EFS) for the SDX55
# Device EFS extraction, based on the apollo port's modem service.
DefaultDependencies=no
After=local-fs.target
Before=tqftpserv-sdx55.service lmi-uim-provision.service
ConditionPathExists=/dev/disk/by-partlabel/mdm1m9kefs1
ConditionPathExists=!/lib/firmware/sdx55m/efs3.bin

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/lmi-efs-extract

[Install]
WantedBy=multi-user.target
