source+=(lmi-wait-loc.c 20-lmi-loc-ready.conf)
sha512sums+=('107a91ee3c3a2d2e123e30ba6ff9c57f0115ef45f96a66678ee3cff70c372ff049de7abd525439cc614b79df8285b1b26ef6861a709c7aa87bdf0c46573483ce' 'c55d738a4ccaac4bb3b65dcd31e172f997dfc6206b23d941a6344a855da105665490f991302de05e97819508c39a69ca111c4245d0a7ffc891d0b3620170a60a')
build() {
  gcc $CFLAGS $LDFLAGS -Wall -Wextra -Werror -o lmi-wait-loc lmi-wait-loc.c $(pkg-config --cflags --libs qrtr-glib)
  for tool in pm_service_native mdm_helper_native mhi_efs_sync diag_reader adsp_diag; do
    gcc $CFLAGS $LDFLAGS -o "$tool" "$tool.c"
  done
  gcc $CFLAGS $LDFLAGS -DHAVE_ZSTD -o tqftpserv-sdx55 \
    tqftpserv.c translate.c zstd-decompress.c -lqrtr -lzstd
}
package() {
  install -Dm755 lmi-wait-loc "$pkgdir/usr/bin/lmi-wait-loc"
  install -Dm644 20-lmi-loc-ready.conf "$pkgdir/usr/lib/systemd/system/ModemManager.service.d/20-lmi-loc-ready.conf"
  for tool in pm_service_native mdm_helper_native mhi_efs_sync diag_reader adsp_diag tqftpserv-sdx55; do
    install -Dm755 "$tool" "$pkgdir/usr/bin/$tool"
  done
  for script in lmi-efs-extract lmi-uim-provision lmi-modem-power-on; do
    install -Dm755 "$script" "$pkgdir/usr/bin/$script"
  done
  for unit in pm-service-native mdm-helper-native mhi-efs-sync adsp-diag tqftpserv-sdx55 lmi-efs-extract lmi-modem-start lmi-modem-rproc; do
    install -Dm644 "$unit.service" "$pkgdir/usr/lib/systemd/system/$unit.service"
  done
  for rule in 77-mm-ignore-sdx55-efs.rules 77-mm-sdx55-fusion.rules; do
    install -Dm644 "$rule" "$pkgdir/usr/lib/udev/rules.d/$rule"
  done
  install -Dm644 rmnet.conf "$pkgdir/usr/lib/modules-load.d/lmi-rmnet.conf"
  install -Dm644 10-lmi-modem-ordering.conf "$pkgdir/usr/lib/systemd/system/ModemManager.service.d/10-lmi-modem-ordering.conf"
  install -Dm644 zz-lmi-multiplex.conf "$pkgdir/usr/lib/systemd/system/ModemManager.service.d/zz-lmi-multiplex.conf"
  install -Dm644 20-lmi-manual-power.conf "$pkgdir/usr/lib/systemd/system/rmtfs.service.d/20-lmi-manual-power.conf"
  install -d "$pkgdir/usr/lib/systemd/system/mhi-efs-sync.service.d"
  printf '[Service]\nTimeoutStartSec=150\n' > "$pkgdir/usr/lib/systemd/system/mhi-efs-sync.service.d/10-lmi.conf"
  install -d "$pkgdir/usr/lib/firmware"
  cp -a --no-preserve=ownership sdx55m "$pkgdir/usr/lib/firmware/"
  # Per-device EFS files are extracted from the phone into RAM at runtime.
  test ! -e "$pkgdir/usr/lib/firmware/sdx55m/efs1.bin"
  test ! -e "$pkgdir/usr/lib/firmware/sdx55m/efs2.bin"
  test ! -e "$pkgdir/usr/lib/firmware/sdx55m/efs3.bin"
  install -d "$pkgdir/etc/systemd/system"
  ln -s /dev/null "$pkgdir/etc/systemd/system/tqftpserv.service"
}
