pkgname=lmi-modem
pkgver=1.0
pkgrel=4
pkgdesc='LMI SDX55 firmware and userspace services, with RAM-only EFS test mode'
arch=(aarch64)
url='https://github.com/linux-msm/tqftpserv'  # modem stack; firmware input is device-private (M1)
license=(GPL-2.0-only BSD-3-Clause LicenseRef-proprietary)
depends=(glibc glib2 libqrtr-glib lmi-qcom-core pd-mapper-lmi modemmanager-lmi libqmi util-linux systemd zstd)
makedepends=(gcc linux-api-headers pkgconf)
options=(!strip)
source=(
  pm_service_native.c
  mdm_helper_native.c
  mhi_efs_sync.c
  diag_reader.c
  adsp_diag.c
  pm-service-native.service
  mdm-helper-native.service
  mhi-efs-sync.service
  adsp-diag.service
  tqftpserv.c
  translate.c
  zstd-decompress.c
  list.h
  translate.h
  zstd-decompress.h
  tqftpserv-sdx55.service
  lmi-efs-extract
  lmi-efs-extract.service
  lmi-uim-provision
  77-mm-ignore-sdx55-efs.rules
  77-mm-sdx55-fusion.rules
  rmnet.conf
  lmi-modem-fw-1.0.tar.gz
  lmi-modem-start.service
  10-lmi-modem-ordering.conf
  lmi-modem-rproc.service lmi-modem-power-on zz-lmi-multiplex.conf
  20-lmi-manual-power.conf)
