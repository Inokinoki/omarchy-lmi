check() {
  bash -n lmi-gnss-prepare
}
package() {
  install -Dm755 lmi-gnss-prepare "$pkgdir/usr/bin/lmi-gnss-prepare"
  install -Dm644 lmi-gnss-prepare.service "$pkgdir/usr/lib/systemd/system/lmi-gnss-prepare.service"
  install -Dm644 30-lmi-gnss.conf "$pkgdir/usr/lib/systemd/system/geoclue.service.d/30-lmi-gnss.conf"
