   aarch64-apple:setup-system | aarch64-apple:setup-user | aarch64-apple:post-install | aarch64-apple:pre-remove | \
     aarch64-apple:enable-fingerprint | aarch64-apple:disable-fingerprint)
     implementation=/usr/lib/omarchy/mac
