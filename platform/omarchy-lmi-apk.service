[Unit]
Description=Local APK installation for the caller's Waydroid session
After=dbus.service

[Service]
Type=dbus
BusName=org.omarchy.Lmi.Android
ExecStart=/usr/lib/omarchy/lmi/apk-service
UMask=0077
LimitCORE=0
CacheDirectory=omarchy-lmi-apks
CacheDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/run/lxc/lock
TimeoutStopSec=10
