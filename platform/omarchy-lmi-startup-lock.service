[Unit]
Description=Lock the LMI desktop after PIN enrollment on session start
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/omarchy-lmi-power-button --startup
TimeoutStartSec=50
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
