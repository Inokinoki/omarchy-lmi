[Unit]
Description=Initial local owner setup for Omarchy LMI
After=graphical-session.target omarchy-lmi-keyboard.service
PartOf=graphical-session.target
ConditionPathExists=/etc/omarchy-lmi/firstboot-pin-needed

[Service]
Type=oneshot
ExecStartPre=/usr/bin/gsettings set org.gnome.desktop.interface color-scheme prefer-dark
ExecStart=/usr/bin/sudo -n /usr/lib/omarchy/lmi/firstboot-pin
LimitCORE=0
TimeoutStartSec=infinity
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
