#!/bin/bash
# omarchy:summary=Finish the phone-specific Omarchy session setup
# omarchy:hidden=true
set -euo pipefail
[[ $(omarchy-hw-platform) == "aarch64-lmi" ]]
systemctl --user daemon-reload
if [[ -s /var/lib/omarchy-lmi/lock-validated/$UID ]]; then
  systemctl --user enable --now omarchy-sleep-lock.service
fi
omarchy-done mark lmi-desktop
