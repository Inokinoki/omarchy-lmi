#!/bin/bash -p
# Fixed entrypoint for lifecycle operations registered by the LMI patch.
set -euo pipefail
export PATH=/usr/bin
operation=${0##*/}

case $operation in
  setup-boot | update-verify)
    [[ -f /run/lmi-persistent ]] || { echo "LMI persistent root is not active." >&2; exit 1; }
    pacman -Q linux-lmi >/dev/null
    [[ -d /run/lmi-storage && -d /run/lmi-lower ]]
    ;;
  setup-system | setup-user | post-install | pre-remove)
    # These operations do not imply generic boot/image provisioning.
    exit 0
    ;;
  *)
    echo "Omarchy LMI: '$operation' is not implemented for this Android boot / ext4 overlay layout. No storage or boot changes were made." >&2
    exit 1
    ;;
esac
