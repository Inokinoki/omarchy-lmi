[Unit]
Description=LMI display orientation and refresh controls
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.omarchy.Lmi.Display
ExecStart=/usr/bin/omarchy-lmi-display serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
