#!/bin/bash -p
# A fixed update boundary: suppress BASH_ENV and exported-function startup injection.
if [[ $- != *p* ]]; then
  exit 126
fi

printf '%s\n' \
  'Omarchy LMI: the PC system-update workflow is not validated for this phone yet.' \
  'It must not migrate the Android boot layout or replace the tested device stack.' \
  'No update was started. Use reviewed LMI port packages during development.' >&2
exit 1
